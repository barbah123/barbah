# Expo public env vars are embedded in the client bundle (not secret).
# Copy this file to `.env` to override the API base URL during development.
#
# Default (when unset) points at the deployed Cloudflare Worker:
#   https://pokemon-auction-api.barbah.workers.dev

# Use the live deployed backend (same as the built-in default):
EXPO_PUBLIC_API_URL=https://pokemon-auction-api.barbah.workers.dev

# Or point at a local `wrangler dev` backend. Use your machine's LAN IP
# (not localhost) so a physical device running Expo Go can reach it, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8787
