# ---- Core ----
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pokemon_auction
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=7d

# ---- Postgres TLS (managed DBs like RDS usually need this) ----
# PGSSL=true

# ---- Image storage ----
# STORAGE_DRIVER=s3            # "s3" or "memory" (defaults to s3 when S3_BUCKET is set)
# S3_BUCKET=pokemon-auction-images
# AWS_REGION=eu-central-1
# S3_ENDPOINT=                 # set for MinIO / S3-compatible endpoints
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=

# ---- AWS SSM secret loading ----
# When USE_SSM=true the app pulls every parameter under SSM_PATH into the
# environment at startup (existing env vars take precedence).
# USE_SSM=true
# SSM_PATH=/pokemon-auction/prod
# AWS_REGION=eu-central-1
# Credentials come from the instance/task IAM role, or AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY for local testing.

# ---- Backups (scripts/backup.sh, scripts/restore.sh) ----
# BACKUP_S3_BUCKET=pokemon-auction-backups
# BACKUP_S3_PREFIX=postgres
# AWS_REGION=eu-central-1
